# Copy this file to .env. Default is Ollama (local, free, no key needed —
# what was used in class). Switch LLM_PROVIDER to gemini/anthropic if you'd
# rather use a cloud model instead.

LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
